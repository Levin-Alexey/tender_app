DATABASE_URL=postgresql://tenderadmin:<password>@<postgres-host>:5432/tenderdb
CLOUDAMQP_URL=amqps://<username>:<password>@<rabbitmq-host>/<vhost>
API_TOKEN=<long-random-secret>
OPENROUTER_API_KEY=<openrouter-api-key>
UNSTRUCTURED_API_KEY=<unstructured-api-key>
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
S3_ENDPOINT_URL=https://<s3-endpoint>
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>
S3_BUCKET=<bucket-name>
S3_PUBLIC_URL_PREFIX=<public-bucket-url>
S3_REGION=us-east-1
